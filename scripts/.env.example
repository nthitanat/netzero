# ============================================
# NetZero Project - Environment Variables Template
# ============================================
# Copy this file to .env and update with your values

# ============================================
# DEPLOYMENT MODE CONTROL
# ============================================
# Set to 'development' or 'production'
# remote-deploy.sh will automatically set this to 'production'
DEPLOYMENT_MODE=development

# ============================================
# REACT CLIENT CONFIGURATION - DEVELOPMENT
# ============================================
DEV_REACT_APP_API_BASE_URL=http://localhost:3001/api
DEV_REACT_APP_CHAT_API_BASE_URL=http://localhost:3004/api
DEV_REACT_APP_USE_REAL_TREE_API=false
DEV_REACT_APP_TREE_IMAGES_BASE_URL=https://your-cdn.com/tree-images
DEV_REACT_APP_ENABLE_API_LOGGING=true

# ============================================
# REACT CLIENT CONFIGURATION - PRODUCTION
# ============================================
PROD_REACT_APP_API_BASE_URL=https://engagement.chula.ac.th/netzero-api/
PROD_REACT_APP_CHAT_API_BASE_URL=https://engagement.chula.ac.th/netzero-api-chat/api/v1/chat
PROD_REACT_APP_USE_REAL_TREE_API=true
PROD_REACT_APP_TREE_IMAGES_BASE_URL=https://your-cdn.com/tree-images
PROD_REACT_APP_ENABLE_API_LOGGING=false

# ============================================
# MAIN SERVER CONFIGURATION - SHARED
# ============================================
PORT=3001
API_PREFIX=/api
API_VERSION=v1

# File Upload Configuration
UPLOAD_DIR=./files
MAX_FILE_SIZE=10485760


RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

