# Copy to .env.development and replace the placeholders. This example is safe to commit.
NODE_ENV=development
CLIENT_PORT=3000

PORT=3001
CHAT_PORT=3004
API_PREFIX=/api
API_VERSION=v1
UPLOAD_DIR=./files
MAX_FILE_SIZE=10485760
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=netzeroadmin
DB_PASSWORD=replace-me
DB_NAME=netzero
JWT_SECRET=replace-me
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001,http://10.201.188.99:3001,http://localhost:3000
SURVEYMONKEY_ACCESS_TOKEN=
SURVEYMONKEY_SURVEY_ID=527787948
SURVEYMONKEY_SURVEY_REDIRECT_URL=https://www.surveymonkey.com/r/GlocalCommunity
SURVEYMONKEY_WEBHOOK_SECRET=

CHAT_DB_HOST=host.docker.internal
CHAT_DB_PORT=3306
CHAT_DB_USER=netzeroadmin
CHAT_DB_PASSWORD=replace-me
CHAT_DB_NAME=netzero
CHAT_JWT_SECRET=replace-me
CHAT_JWT_EXPIRES_IN=24h
OPENAI_API_KEY=replace-me
CHAT_CORS_ORIGINS=http://localhost:3000
CHAT_VECTOR_STORE_ID=replace-me

REACT_APP_API_BASE_URL=http://localhost:3001
REACT_APP_CHAT_API_BASE_URL=http://localhost:3004/api/v1
REACT_APP_USE_REAL_TREE_API=false
REACT_APP_STATIC_ASSET_BASE_URL=
